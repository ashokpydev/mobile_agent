ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./privacy_guardian.db
REDIS_URL=redis://localhost:6379/0
ENCRYPTION_KEY=replace-with-generated-fernet-key
AUDIT_LOG_SIGNING_KEY=replace-with-random-signing-key
API_KEY=replace-with-random-api-key
API_KEY_SCOPES=analysis:read,analysis:write,agent:ask,privacy:admin
RATE_LIMIT_REQUESTS_PER_MINUTE=60
REQUIRE_USER_CONSENT=true
DEFAULT_RETENTION_DAYS=30
RAW_ARTIFACT_RETENTION_HOURS=0
ACTION_LOG_PATH=logs/actions.log
ACTION_LOG_MAX_BYTES=5000000
SECURITY_HEADERS_ENABLED=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
ENABLE_EXTERNAL_AI=false
OPENAI_API_KEY=
GEMINI_API_KEY=
