ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./privacy_guardian.db
REDIS_URL=redis://localhost:6379/0
ENCRYPTION_KEY=replace-with-generated-fernet-key
API_KEY=replace-with-random-api-key
API_KEY_SCOPES=analysis:read,analysis:write,agent:ask,privacy:admin
RATE_LIMIT_REQUESTS_PER_MINUTE=60
REQUIRE_USER_CONSENT=true
DEFAULT_RETENTION_DAYS=30
RAW_ARTIFACT_RETENTION_HOURS=0
ENABLE_EXTERNAL_AI=false
OPENAI_API_KEY=
GEMINI_API_KEY=
